# Copy to .env (git-ignored) and fill in. The PUBLIC repo ships only this template —
# no credentials, funder name, staff names, CRM ids, or local paths live in git.
ZOHO_ENV=./.zoho.env                 # path to a file holding ZOHO_CLIENT_ID / ZOHO_CLIENT_SECRET / ZOHO_REFRESH_TOKEN
ZOHO_ORG=YOUR_ZOHO_ORG_ID            # numeric Zoho CRM org id
OUTREACH_MODULE=CustomModuleXX       # Zoho URL segment for the outreach-activities module
STUDENTS_MODULE=CustomModuleXX       # Zoho URL segment for the students module
STUDENTS_VIEW=YOUR_LIST_VIEW_ID      # a saved list-view id for the students module
GOAL_TARGET=40                       # numeric goal
GOAL_LABEL=Refugee-employment goal   # label shown on the goal bar
OFFICERS=Officer 1,Officer 2,Officer 3   # comma-separated names that match the CRM Owner field
REPO_URL=https://github.com/OWNER/REPO
